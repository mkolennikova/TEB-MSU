&tebparam
 dt=300.,
 teb_utc_hour=3,
 urb_h_bld=20.,
 urb_fr_bld=0.62,
 urb_h2w=1.38158,
 !MV202609 z0 and zd to namelist
 ! aerodynamics of the urban surface:
 !   urb_z0_town   - roughness length for momentum
 !   urb_zd_town   - displacement height (zd)
 ! accepted forms (case insensitive):
 !   0.5 | 0.5m   - value in metres
 !   0.1H         - fraction of urb_h_bld
 !   H/3          - urb_h_bld divided by n
 !   <name>       - parameterization by name:
 !                  MACDONALD1998 (staggered), MACDONALD1998SQ (square)
 ! each entry is resolved independently, e.g. urb_z0_town='0.1H' together with
 ! urb_zd_town='MACDONALD1998'
 urb_z0_town='0.1H',
 urb_zd_town='H/3',
 teb_road_dir=0.,
 teb_hroad_dir='UNIF',
 teb_wall_opt='UNIF',
 teb_ti_bld=292.15,
 teb_qi_bld=0.0068794074,
 urb_alb_rf_so=0.4,
 urb_alb_rf_th=0.03,
 urb_hcap_rf=1580000.,
 urb_hcon_rf=1.15,
 urb_alb_rd_so=0.08,
 urb_alb_rd_th=0.04,
 urb_hcap_rd=1740000.,
 urb_hcon_rd=0.82,
 urb_alb_wl_so=0.32,
 urb_alb_wl_th=0.03,
 urb_hcap_wl=1580000.,
 urb_hcon_wl=1.15,
 teb_itype_bem='BEM',
 teb_lbem_ac=.TRUE.,
 teb_itype_natvent='AUTO',
 teb_itype_bem_cool='IDEAL ',
 teb_itype_bem_heat='IDEAL ',
 teb_frac_gz=0.2,
 teb_tcool_target=297.16,
 teb_theat_target=292.16,
 teb_zresidential=1.,
 teb_dt_res=0.,
 teb_dt_off=0.,
 teb_bem_inf=0.5,
 teb_bem_vent=0.0,
 teb_bem_cop=2.5,
 teb_cap_sys_rat=100.0,
 teb_m_sys_rat=0.0067,
 teb_cap_sys_heat=90.,
 ahf_traffic=0.0,
 ahf_industry=0.0,
 teb_itype_wind=0,
 teb_fai=0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5,
 teb_lgarden=.FALSE.,
 fr_garden=0.0,
 teb_type_garden='PROXY_NEW',
 !MV202609 surface properties of the garden and of the greenroof:
 !  urb_z0_gdn / urb_alb_gdn / urb_emis_gdn - garden roughness length (m),
 !  albedo, emissivity; urb_z0_grf / urb_alb_grf / urb_emis_grf - the same
 !  for the greenroof. One value per surface, used by all the models
 !  (internal proxies and external ones) and by the canyon radiation budget.
 !  Defaults: 0.1 / 0.15 / 0.98 (garden), 0.01 / 0.15 / 0.98 (greenroof).
 !  Albedo must be in [0,1), emissivity in (0,1]; other values stop the run.
 urb_z0_gdn=0.1,
 urb_alb_gdn=0.15,
 urb_emis_gdn=0.98,
 teb_lgreenroof=.FALSE.,
 teb_frac_gr=0.0,
 urb_z0_grf=0.01,
 urb_alb_grf=0.15,
 urb_emis_grf=0.98,
 teb_lsolar_panel=.FALSE.,
 teb_fr_panel=0.,
 teb_lroad_irrig=.FALSE.,
 teb_rd_irrig_start_m=6.,
 teb_rd_irrig_end_m=8.,
 teb_rd_irrig_start_h=6.,
 teb_rd_irrig_end_h=9.,
 teb_rd_irrig_sum=1.
/