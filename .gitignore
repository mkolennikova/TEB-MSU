*.pyc
__pycache__/
*.zip
*.o
*.exe
*.mod
build/*
output/
TEB_log.txt
model_output.log
*_output.txt
python/*/
python_tests/*/
.vscode/settings.json
/logo_design/
_temp/

# python_tests/*/ above ignores every subdirectory; the upstream_cons_test
# bench is a tracked subdirectory (its code, not its runs).
!python_tests/upstream_cons_test/
!python_tests/upstream_cons_test/**
python_tests/upstream_cons_test/run/

# Tracked ctrl/dev base comparison bench; its runs go under build/.
!python_tests/ctrl_dev_base_test/
!python_tests/ctrl_dev_base_test/**

# The byte code of these subdirectories must stay ignored: the '!' rules above come
# later than the global *.pyc / __pycache__ patterns, so they are repeated here
__pycache__/
*.pyc
